{
  "data": [
    {
      "EXE": "IsCheck_NotRoleParent(vueData.user)"
    },
    {
      "DSLop": [],
      "DSLopChuNhiem": [],
      "LopItem": null,
      "DSTuan": [],
      "TuanXemTKB": null,
      "TKBRaw": null,
      "TKBTuanInfo": null,
      "DSTKB": [],
      "TKBQueue": [],
      "TKBKeyDangChon": null,
      "isLoadingTKB": false,
      "NgayApDung": null,
      "Buoi": 1,
      "DSBuoi": [
        { "title": "Sáng", "value": 1 },
        { "title": "Chiều", "value": 2 },
        { "title": "Tối", "value": 3 }
      ],
      "TietBatDau": 1,
      "TietKetThuc": 1,
      "DSTiet": [1, 2, 3, 4, 5],
      "DSLoaiThietBi": ["Laptop", "Tablet", "Điện thoại di động", "Thiết bị khác"],
      "DSHocSinhLop": [],
      "HocSinhThietBi": [],
      "TimKiemHocSinh": "",
      "GhiChu": "",
      "DSDangKy": [],
      "isLoadingSave": false,
      "headersDangKy": [
        { "title": "Lớp", "value": "TenLop", "width": "80px" },
        { "title": "Loại TB", "value": "LoaiThietBi", "width": "90px" },
        { "title": "Ngày áp dụng", "value": "NgayApDungHienThi", "width": "120px" },
        { "title": "Thứ", "value": "ThuHienThi", "width": "70px", "align": "center" },
        { "title": "Buổi", "value": "BuoiHienThi", "width": "70px", "align": "center" },
        { "title": "Tiết", "value": "TietHienThi", "width": "80px", "align": "center" },
        { "title": "Số HS", "value": "SoHocSinh", "el": "t-num", "width": "70px" },
        { "title": "Ghi chú", "value": "GhiChu" },
        { "title": "Trễ hạn", "value": "TreHanHienThi", "width": "80px", "align": "center" },
        { "title": "", "value": "ctrl-del", "el": "t-button", "width": "60px", "attr": { "icon-text": "mdi-delete", "color": "warning", ":action": { "CALL": "xoaDangKy" } } }
      ]
    },
    {
      "getDSLop": {
        "API": "lms/GiaoVienLop_Get_By_GiaoVienID",
        "IN": { "GiaoVienID": "vueData.user.UserID" },
        "OUT": "DSLop",
        "CALLBACK": { "EXE": "runAction(vueData.getDSLopChuNhiem)" }
      },
      "getDSLopChuNhiem": {
        "API": "lms/Lop_Get_ByGVCN",
        "IN": { "NienKhoa": "vueData.NienKhoa", "sys_UserID": "vueData.user.UserID" },
        "OUT": "DSLopChuNhiem",
        "CALLBACK": { "EXE": "renderDSLop(); runAction(vueData.getDSTuan); runAction(vueData.getDSDangKy)" }
      },
      "getDSTuan": {
        "API": "lms/TuanHocTap_Get",
        "IN": { "NienKhoa": "vueData.NienKhoa" },
        "OUT": "DSTuan",
        "CALLBACK": { "EXE": "chonTuanTKBHienTai()" }
      },
      "getTKB": {
        "API": "https://tapi.lhbs.vn/quansinh/ThoiKhoaBieu_GiaoVien",
        "IN": {
          "NgayDauTuan": "vueData.tinhNgayDauTuanTKB()",
          "GiaoVienID": "vueData.user.UserID"
        },
        "OUT": "TKBRaw",
        "CALLBACK": { "EXE": "renderTKB()" }
      },
      "getDSHocSinhLop": {
        "API": "lms/HocSinhLop_Get_ByLopID",
        "IN": { "LopID": "vueData.LopItem.LopID", "NienKhoa": "vueData.NienKhoa" },
        "OUT": "DSHocSinhLop",
        "CALLBACK": { "EXE": "initHocSinhThietBi()" }
      },
      "getDSDangKy": {
        "API": "lms/DangKyMangLaptop_Get",
        "IN": {
          "NienKhoa": "vueData.NienKhoa",
          "TuanHocID": 0,
          "LopID": 0,
          "KhoiID": 0,
          "ViewMode": "`GVBM"
        },
        "OUT": "DSDangKy",
        "CALLBACK": { "EXE": "renderDSDangKy()" }
      },
      "xoaDangKy": {
        "CONFIRM": "Xác nhận xóa đăng ký này?",
        "API": "lms/DangKyMangLaptop_Del",
        "IN": { "DangKyID": "item.DangKyID" },
        "CALLBACK": { "CALL": "getDSDangKy", "MESS": "Đã xóa" }
      }
    },
    {
      "EXE": "(function(){ var t=setInterval(function(){ if(vueData.NienKhoa){ clearInterval(t); runAction(vueData.getDSLop); } }, 100); setTimeout(function(){ clearInterval(t); }, 8000); })()"
    }
  ],
  "watch": {
    "LopItem": {
      "IF": "vueData.LopItem?.LopID > 0",
      "THEN": [
        { "DSHocSinhLop": [], "HocSinhThietBi": [] },
        { "CALL": "getDSHocSinhLop" },
        { "CALL": "getDSDangKy" }
      ]
    },
    "TuanXemTKB": { "CALL": "getTKB" }
  },
  "controls": [
    {
      "prop": "fluid grid-list-md",
      "rows": [
        {
          "prop": "",
          "cols": [
            {
              "el": "v-card",
              "attr": { "class": "pa-4 mb-4" },
              "innerHTML": [
                {
                  "el": "v-card-title",
                  "attr": { "class": "text-primary px-0 pt-0 d-flex align-center ga-2" },
                  "innerHTML": [
                    { "el": "v-icon", "innerHTML": "mdi-calendar-clock" },
                    { "el": "span", "innerHTML": "Thời khóa biểu của tôi" },
                    { "el": "span", "attr": { "class": "text-caption text-medium-emphasis" }, "innerHTML": "— bấm vào ô có tiết dạy để tự điền form đăng ký bên dưới" }
                  ]
                },
                { "el": "v-divider", "attr": { "class": "mb-3" } },
                {
                  "el": "div",
                  "attr": { "class": "d-flex flex-wrap align-center ga-4 mb-2" },
                  "innerHTML": [
                    {
                      "el": "div",
                      "attr": { "class": "d-flex align-center ga-1" },
                      "innerHTML": [
                        { "el": "span", "attr": { "style": "display:inline-block;width:14px;height:14px;background:#B2DFDB;border:1px solid #ccc" } },
                        { "el": "span", "attr": { "class": "text-caption" }, "innerHTML": "Đã đăng ký" }
                      ]
                    },
                    {
                      "el": "div",
                      "attr": { "class": "d-flex align-center ga-1" },
                      "innerHTML": [
                        { "el": "span", "attr": { "style": "display:inline-block;width:14px;height:14px;background:#BBDEFB;border:1px solid #ccc" } },
                        { "el": "span", "attr": { "class": "text-caption" }, "innerHTML": "Đang chọn để đăng ký" }
                      ]
                    },
                    {
                      "el": "div",
                      "attr": { "class": "d-flex align-center ga-1" },
                      "innerHTML": [
                        { "el": "span", "attr": { "style": "display:inline-block;width:14px;height:14px;background:#E8F5E9;border:1px solid #ccc" } },
                        { "el": "span", "attr": { "class": "text-caption" }, "innerHTML": "Có tiết dạy, chưa đăng ký" }
                      ]
                    }
                  ]
                },
                {
                  "el": "v-row",
                  "innerHTML": [
                    {
                      "el": "v-col",
                      "attr": { ":cols": 12, ":sm": 5 },
                      "innerHTML": [
                        {
                          "el": "v-select",
                          "attr": {
                            "v-model": "TuanXemTKB",
                            "label": "Chọn tuần",
                            ":items": "DSTuan",
                            "item-title": "Tuan_HienThi",
                            ":return-object": true,
                            "hide-details": "auto",
                            ":loading": "isLoadingTKB"
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "el": "div",
                  "attr": { "class": "mt-3", "style": "overflow-x:auto" },
                  "innerHTML": [
                    {
                      "el": "table",
                      "attr": { "class": "w-100 text-caption", "style": "border-collapse:collapse; min-width:700px" },
                      "innerHTML": [
                        {
                          "el": "thead",
                          "innerHTML": [
                            {
                              "el": "tr",
                              "innerHTML": [
                                { "el": "th", "attr": { "class": "pa-2 border" }, "innerHTML": "" },
                                { "el": "th", "attr": { "class": "pa-2 border" }, "innerHTML": "Thứ 2" },
                                { "el": "th", "attr": { "class": "pa-2 border" }, "innerHTML": "Thứ 3" },
                                { "el": "th", "attr": { "class": "pa-2 border" }, "innerHTML": "Thứ 4" },
                                { "el": "th", "attr": { "class": "pa-2 border" }, "innerHTML": "Thứ 5" },
                                { "el": "th", "attr": { "class": "pa-2 border" }, "innerHTML": "Thứ 6" },
                                { "el": "th", "attr": { "class": "pa-2 border" }, "innerHTML": "Thứ 7" },
                                { "el": "th", "attr": { "class": "pa-2 border" }, "innerHTML": "CN" }
                              ]
                            }
                          ]
                        },
                        {
                          "el": "tbody",
                          "innerHTML": [
                            {
                              "el": "tr",
                              "attr": { "v-for": "row in vueData.DSTKB", ":key": "row.Buoi + '_' + row.Tiet" },
                              "innerHTML": [
                                { "el": "td", "attr": { "class": "pa-2 border font-weight-medium text-no-wrap" }, "innerHTML": "{{row.TenBuoi}} - T{{row.Tiet}}" },
                                {
                                  "el": "td",
                                  "attr": {
                                    "v-for": "cell in row.Cells",
                                    ":key": "cell.ThuKey",
                                    "class": "pa-2 border text-center",
                                    ":style": "!cell.CoTiet ? '' : (vueData.isTietDaChon(row, cell) ? 'cursor:pointer;background:#BBDEFB;font-weight:600' : (cell.IsDaDangKy ? 'cursor:pointer;background:#B2DFDB;font-weight:600' : 'cursor:pointer;background:#E8F5E9'))",
                                    "v-on:click": "cell.CoTiet ? vueData.onChonTietTKB(row, cell) : null"
                                  },
                                  "innerHTML": [
                                    { "el": "span", "innerHTML": "{{cell.TenLop}}{{cell.TenMon ? ' - ' + cell.TenMon : ''}}" },
                                    { "el": "v-icon", "attr": { "v-if": "cell.IsDaDangKy", "size": "x-small", "color": "teal-darken-3", "class": "ml-1" }, "innerHTML": "mdi-check-circle" }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "el": "div",
                  "attr": { "v-if": "vueData.TKBQueue.length>0", "class": "mt-3 d-flex flex-wrap align-center ga-2" },
                  "innerHTML": [
                    { "el": "span", "attr": { "class": "text-caption text-medium-emphasis" }, "innerHTML": "Đã chọn để đăng ký:" },
                    {
                      "el": "v-chip",
                      "attr": {
                        "v-for": "item in vueData.TKBQueue",
                        ":key": "item.key",
                        "size": "small",
                        ":color": "vueData.TKBKeyDangChon===item.key ? 'primary' : 'default'",
                        ":variant": "vueData.TKBKeyDangChon===item.key ? 'flat' : 'tonal'",
                        ":closable": true,
                        "v-on:click": "vueData.dienFormTuTiet(item)",
                        "v-on:click:close": "vueData.boChonTietTKB(item)"
                      },
                      "innerHTML": "{{item.TenLop}} - {{item.TenBuoi || (item.Buoi===1?'Sáng':item.Buoi===2?'Chiều':'Tối')}} T{{item.Tiet}}"
                    }
                  ]
                }
              ],
              "w": 12
            },
            {
              "el": "v-card",
              "attr": { "class": "pa-4 mb-4" },
              "innerHTML": [
                {
                  "el": "v-card-title",
                  "attr": { "class": "text-primary px-0 pt-0 d-flex align-center ga-2" },
                  "innerHTML": [
                    { "el": "v-icon", "innerHTML": "mdi-laptop" },
                    { "el": "span", "innerHTML": "Đăng ký học sinh mang Laptop" }
                  ]
                },
                { "el": "v-divider", "attr": { "class": "mb-4" } },
                {
                  "el": "v-row",
                  "innerHTML": [
                    {
                      "el": "v-col",
                      "attr": { ":cols": 12, ":sm": 6 },
                      "innerHTML": [
                        {
                          "el": "v-select",
                          "attr": {
                            "v-model": "LopItem",
                            "label": "Chọn Lớp",
                            ":items": "DSLop_HienThi",
                            "item-title": "TenHienThi",
                            "item-value": "LopID",
                            ":return-object": true,
                            "hide-details": "auto"
                          }
                        }
                      ]
                    },
                    {
                      "el": "v-col",
                      "attr": { ":cols": 12, ":sm": 6 },
                      "innerHTML": [
                        {
                          "el": "f-date",
                          "attr": {
                            "v-model": "NgayApDung",
                            "label": "Ngày áp dụng",
                            ":required": true
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "el": "v-row",
                  "innerHTML": [
                    {
                      "el": "v-col",
                      "attr": { ":cols": 12, ":sm": 4 },
                      "innerHTML": [
                        {
                          "el": "v-select",
                          "attr": {
                            "v-model": "Buoi",
                            "label": "Buổi",
                            ":items": "DSBuoi",
                            "item-title": "title",
                            "item-value": "value",
                            "hide-details": "auto"
                          }
                        }
                      ]
                    },
                    {
                      "el": "v-col",
                      "attr": { ":cols": 6, ":sm": 4 },
                      "innerHTML": [
                        {
                          "el": "v-select",
                          "attr": {
                            "v-model": "TietBatDau",
                            "label": "Tiết bắt đầu",
                            ":items": "DSTiet",
                            "hide-details": "auto"
                          }
                        }
                      ]
                    },
                    {
                      "el": "v-col",
                      "attr": { ":cols": 6, ":sm": 4 },
                      "innerHTML": [
                        {
                          "el": "v-select",
                          "attr": {
                            "v-model": "TietKetThuc",
                            "label": "Tiết kết thúc",
                            ":items": "DSTiet",
                            "hide-details": "auto"
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "el": "v-row",
                  "innerHTML": [
                    {
                      "el": "v-col",
                      "attr": { ":cols": 12 },
                      "innerHTML": [
                        {
                          "el": "v-text-field",
                          "attr": {
                            "v-model": "GhiChu",
                            "label": "Ghi chú",
                            "hide-details": "auto"
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "el": "div",
                  "attr": { "v-if": "vueData.LopItem", "class": "mt-3" },
                  "innerHTML": [
                    {
                      "el": "div",
                      "attr": { "class": "d-flex align-center flex-wrap mb-2 ga-2" },
                      "innerHTML": [
                        { "el": "span", "attr": { "class": "text-subtitle-2 text-medium-emphasis" }, "innerHTML": "Học sinh mang thiết bị — mặc định cả lớp, bỏ chọn nếu có em không mang" },
                        { "el": "v-spacer" },
                        {
                          "el": "v-text-field",
                          "attr": {
                            "v-model": "TimKiemHocSinh",
                            "label": "Tìm học sinh",
                            "prepend-inner-icon": "mdi-magnify",
                            "density": "compact",
                            ":clearable": true,
                            "hide-details": "auto",
                            "style": "max-width:220px"
                          }
                        },
                        {
                          "el": "v-btn",
                          "attr": { "size": "small", "variant": "text", "color": "primary", "v-on:click": "vueData.chonTatCaHocSinh()" },
                          "innerHTML": "Chọn tất cả"
                        },
                        {
                          "el": "v-btn",
                          "attr": { "size": "small", "variant": "text", "v-on:click": "vueData.boChonTatCaHocSinh()" },
                          "innerHTML": "Bỏ chọn tất cả"
                        }
                      ]
                    },
                    {
                      "el": "div",
                      "attr": { "class": "border rounded", "style": "max-height:420px; overflow-y:auto" },
                      "innerHTML": [
                        {
                          "el": "table",
                          "attr": { "class": "w-100 text-body-2 hs-thietbi-table" },
                          "innerHTML": [
                            {
                              "el": "thead",
                              "innerHTML": [
                                {
                                  "el": "tr",
                                  "attr": { "class": "bg-grey-lighten-4" },
                                  "innerHTML": [
                                    { "el": "th", "attr": { "class": "pa-1", "style": "width:36px" }, "innerHTML": "" },
                                    { "el": "th", "attr": { "class": "pa-2 text-left text-no-wrap" }, "innerHTML": "Mã HS" },
                                    { "el": "th", "attr": { "class": "pa-2 text-left text-no-wrap" }, "innerHTML": "SDB" },
                                    { "el": "th", "attr": { "class": "pa-2 text-left" }, "innerHTML": "Học sinh" },
                                    {
                                      "el": "th",
                                      "attr": { "v-for": "loai in vueData.DSLoaiThietBi", ":key": "loai", "class": "pa-1 text-center text-no-wrap" },
                                      "innerHTML": [
                                        {
                                          "el": "div",
                                          "attr": { "class": "d-flex flex-column align-center" },
                                          "innerHTML": [
                                            { "el": "span", "innerHTML": "{{loai}}" },
                                            {
                                              "el": "div",
                                              "attr": { "class": "d-flex justify-center" },
                                              "innerHTML": [
                                                {
                                                  "el": "v-checkbox",
                                                  "attr": {
                                                    ":model-value": "vueData.isCotThietBiChonHet(loai)",
                                                    "density": "compact",
                                                    "hide-details": "auto",
                                                    "title": "Chọn tất cả cột này",
                                                    "v-on:update:model-value": "vueData.toggleCotThietBi(loai)"
                                                  }
                                                }
                                              ]
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "el": "tbody",
                              "innerHTML": [
                                {
                                  "el": "tr",
                                  "attr": { "v-for": "hs in vueData.HocSinhThietBi.filter(x => !vueData.TimKiemHocSinh || x.HoTen.toLowerCase().includes(vueData.TimKiemHocSinh.toLowerCase()))", ":key": "hs.HocSinhID", "class": "border-t" },
                                  "innerHTML": [
                                    {
                                      "el": "td",
                                      "attr": { "class": "pa-0 text-center" },
                                      "innerHTML": [
                                        {
                                          "el": "div",
                                          "attr": { "class": "d-flex justify-center" },
                                          "innerHTML": [
                                            {
                                              "el": "v-checkbox",
                                              "attr": {
                                                ":model-value": "hs.IsChon",
                                                "density": "compact",
                                                "hide-details": "auto",
                                                "v-on:update:model-value": "vueData.toggleChonHocSinh(hs)"
                                              }
                                            }
                                          ]
                                        }
                                      ]
                                    },
                                    { "el": "td", "attr": { "class": "pa-1 text-medium-emphasis" }, "innerHTML": "{{hs.HocSinhID}}" },
                                    { "el": "td", "attr": { "class": "pa-1 text-medium-emphasis" }, "innerHTML": "{{hs.SoDanhBo}}" },
                                    { "el": "td", "attr": { "class": "pa-1" }, "innerHTML": "{{hs.HoTen}}" },
                                    {
                                      "el": "td",
                                      "attr": { "v-for": "loai in vueData.DSLoaiThietBi", ":key": "loai", "class": "pa-0 text-center" },
                                      "innerHTML": [
                                        {
                                          "el": "div",
                                          "attr": { "class": "d-flex justify-center" },
                                          "innerHTML": [
                                            {
                                              "el": "v-checkbox",
                                              "attr": {
                                                ":model-value": "hs.ThietBiChon.includes(loai)",
                                                ":disabled": "!hs.IsChon",
                                                "density": "compact",
                                                "hide-details": "auto",
                                                "v-on:update:model-value": "vueData.toggleThietBi(hs, loai)"
                                              }
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "el": "div",
                      "attr": { "v-if": "vueData.DSHocSinhLop.length===0", "class": "text-caption text-medium-emphasis pa-2" },
                      "innerHTML": "Lớp chưa có học sinh"
                    }
                  ]
                },
                {
                  "el": "v-chip",
                  "attr": {
                    "v-if": "vueData.canhBaoTreHan()",
                    "color": "warning",
                    "variant": "flat",
                    "size": "small",
                    "prepend-icon": "mdi-alert",
                    "class": "mt-2"
                  },
                  "innerHTML": "Trễ hạn quy định (sáng thứ Hai hằng tuần; nếu dùng thứ Hai thì hạn chiều Chủ nhật trước đó) — vẫn lưu được nhưng cần báo GVCN/quản sinh."
                },
                { "el": "v-divider", "attr": { "class": "mt-4" } },
                {
                  "el": "v-card-actions",
                  "attr": { "class": "px-0" },
                  "innerHTML": [
                    {
                      "el": "v-spacer"
                    },
                    {
                      "el": "v-btn",
                      "attr": {
                        "color": "primary",
                        "prepend-icon": "mdi-content-save",
                        "text": "Đăng ký",
                        ":loading": "isLoadingSave",
                        ":disabled": "!LopItem || !NgayApDung || HocSinhThietBi.filter(x=>x.IsChon).length===0",
                        "v-on:click": "vueData.submitDangKy()"
                      }
                    }
                  ]
                }
              ],
              "w": 12
            },
            {
              "el": "v-card",
              "attr": { "class": "pa-4" },
              "innerHTML": [
                {
                  "el": "v-card-title",
                  "attr": { "class": "text-primary px-0 pt-0 d-flex align-center ga-2" },
                  "innerHTML": [
                    { "el": "v-icon", "innerHTML": "mdi-format-list-bulleted" },
                    { "el": "span", "innerHTML": "Danh sách đã đăng ký" }
                  ]
                },
                { "el": "v-divider", "attr": { "class": "mb-2" } },
                {
                  "el": "f-table",
                  "attr": {
                    "label": "",
                    ":headers": "headersDangKy",
                    ":items": "DSDangKy",
                    "show-search": true,
                    ":fixed-header": true,
                    "height": "500"
                  }
                }
              ],
              "w": 12
            }
          ]
        }
      ]
    }
  ],
  "set": {}
}
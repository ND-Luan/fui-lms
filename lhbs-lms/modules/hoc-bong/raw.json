{
  "data": [
    {
      "EXE": "IsCheck_NotRoleParent(vueData.user)"
    },
    {
      "CALL": "getAllHocSinh"
    },
    {
      "instance": null,
      "DSKhoi": [
        {
          "title": "Tất cả",
          "value": 0,
          "CapID": 0
        },
        {
          "title": "Khối 6",
          "value": 6,
          "CapID": 2
        },
        {
          "title": "Khối 7",
          "value": 7,
          "CapID": 2
        },
        {
          "title": "Khối 8",
          "value": 8,
          "CapID": 2
        },
        {
          "title": "Khối 9",
          "value": 9,
          "CapID": 2
        },
        {
          "title": "Khối 10",
          "value": 10,
          "CapID": 3
        },
        {
          "title": "Khối 11",
          "value": 11,
          "CapID": 3
        },
        {
          "title": "Khối 12",
          "value": 12,
          "CapID": 3
        }
      ],
      "KhoiItem": null,
      "keyComp": 0,
      "columnHeader": [],
      "DSHocSinh": [],
      "TinhTrang": null,
      "styleSheet": {},
      "comments": {},
      "freezeColumns": 4,
      "Semester": {
        "title": "Học kì 1",
        "value": 1
      },
      "DSSemester": [
        {
          "title": "Học kì 1",
          "value": 1
        },
        {
          "title": "Học kì 2",
          "value": 2
        },
        {
          "title": "Cả năm",
          "value": 0
        }
      ],
      "DSHocSinhChange": [],
      "IsShowDialogConfirm": false,
      "isLoadingPrint": false,
      "isLoadingSave": false,
      "isLoadingAdd": false,
      "isLoadingDel": false,
      "DSHocBong": [],
      "DSAllHocSinh": [],
      "IsShowDialogAdd": false,
      "IsShowDialogDel": false,
      "AddHocSinhSelected": null,
      "AddMucHocBong": "25% học phí học kì I",
      "DelHocSinhSelected": []
    },
    {
      "getHocBong": {
        "API": "lms/HocBongCert_Get",
        "IN": {
          "KhoiID": "vueData.KhoiItem.value",
          "HocKy": "vueData.Semester.value",
          "NienKhoa": "vueData.NienKhoa"
        },
        "OUT": "DSHocBong",
        "CALLBACK": {
          "EXE": "renderDSHocBong()"
        }
      },
      "getAllHocSinh": {
        "API": "lms/HocSinh_Get",
        "IN": {
          "NienKhoa": "vueData.NienKhoa"
        },
        "OUT": "DSAllHocSinh"
      }
    }
  ],
  "watch": {
    "NienKhoa": [
      {
        "EXE": "vueData.KhoiItem = null; vueData.DSHocSinh = []"
      }
    ],
    "KhoiItem": {
      "IF": "vueData.KhoiItem?.value !== null && vueData.KhoiItem?.value !== undefined",
      "THEN": [
        {
          "DSHocSinh": [],
          "DSHocBong": [],
          "DSHocSinhChange": []
        },
        {
          "CALL": "getHocBong"
        }
      ]
    },
    "Semester": {
      "IF": "vueData.KhoiItem?.value !== null && vueData.KhoiItem?.value !== undefined",
      "THEN": [
        {
          "DSHocSinh": [],
          "DSHocBong": [],
          "DSHocSinhChange": []
        },
        {
          "CALL": "getHocBong"
        }
      ]
    }
  },
  "controls": [
    {
      "prop": "fluid grid-list-md",
      "rows": [
        {
          "prop": "",
          "cols": [
            {
              "el": "v-card",
              "attr": {},
              "innerHTML": [
                {
                  "el": "v-card-title",
                  "attr": {
                    "class": "text-primary px-0 pt-0"
                  },
                  "innerHTML": [
                    {
                      "el": "span",
                      "innerHTML": "Học bổng"
                    },
                    {
                      "el": "v-chip",
                      "attr": {
                        "color": "primary",
                        "variant": "text",
                        "class": "font-weight-medium"
                      },
                      "innerHTML": "Tổng số học sinh: {{DSHocSinh.length}}"
                    }
                  ]
                },
                {
                  "el": "v-row",
                  "innerHTML": [
                    {
                      "el": "v-col",
                      "attr": {
                        ":cols": 3,
                        "class": "ms-1"
                      },
                      "innerHTML": [
                        {
                          "el": "v-select",
                          "attr": {
                            "v-model": "Semester",
                            "label": "Chọn học kì",
                            ":items": "DSSemester",
                            "hide-details": "auto",
                            "item-title": "title",
                            "item-value": "value",
                            ":return-object": true
                          }
                        }
                      ]
                    },
                    {
                      "el": "v-col",
                      "attr": {
                        ":cols": 3
                      },
                      "innerHTML": [
                        {
                          "el": "v-select",
                          "attr": {
                            "v-model": "KhoiItem",
                            "label": "Chọn khối",
                            ":items": "DSKhoi",
                            "item-title": "title",
                            "item-value": "value",
                            ":return-object": true,
                            "hide-details": "auto"
                          }
                        }
                      ]
                    },
                    {
                      "el": "v-col",
                      "attr": {
                        "class": "d-flex ga-2 me-1",
                        ":cols": "auto"
                      },
                      "innerHTML": [
                        {
                          "el": "f-button",
                          "attr": {
                            "prepend-icon": "mdi-refresh",
                            "variant": "outlined",
                            "label": "Làm mới",
                            "color": "primary",
                            ":action": "getHocBong"
                          }
                        },
                        {
                          "el": "v-btn",
                          "attr": {
                            "prepend-icon": "mdi-account-plus",
                            "text": "Thêm học sinh",
                            "variant": "outlined",
                            "color": "success",
                            "v-on:click": "() => { vueData.AddHocSinhSelected = null; vueData.AddMucHocBong = '25% học phí học kì I'; vueData.IsShowDialogAdd = true }"
                          }
                        },
                        {
                          "el": "v-btn",
                          "attr": {
                            ":disabled": "DSHocBong.length === 0",
                            "prepend-icon": "mdi-account-minus",
                            "text": "Xóa học sinh",
                            "variant": "outlined",
                            "color": "warning",
                            "v-on:click": "() => { vueData.DelHocSinhSelected = []; vueData.IsShowDialogDel = true }"
                          }
                        },
                        {
                          "el": "v-spacer"
                        },
                        {
                          "el": "v-btn",
                          "attr": {
                            ":disabled": "DSHocBong.length === 0",
                            "prepend-icon": "mdi-file-excel",
                            "text": "Xuất file Excel",
                            "color": "primary",
                            "variant": "outlined",
                            "v-on:click": "onExportExcel"
                          }
                        },
                        {
                          "el": "v-btn",
                          "attr": {
                            ":disabled": "DSHocBong.length === 0",
                            "text": "Lưu",
                            "prepend-icon": "mdi-content-save",
                            "variant": "outlined",
                            "color": "primary",
                            "v-on:click": "onSave"
                          }
                        },
                        {
                          "el": "v-btn",
                          "attr": {
                            ":disabled": "DSHocBong.length === 0",
                            ":loading": "isLoadingPrint",
                            "text": "In giấy chứng nhận",
                            "prepend-icon": "mdi-certificate-outline",
                            "variant": "outlined",
                            "color": "orange",
                            "v-on:click": "exportGiayChungNhanHocBong"
                          }
                        }
                      ]
                    }
                  ]
                }
              ],
              "w": 12
            },
            {
              "el": "v-card",
              "innerHTML": [
                {
                  "el": "v-card-text",
                  "attr": {
                    "class": "pa-0"
                  },
                  "innerHTML": [
                    {
                      "el": "uc-jexcel-hoc-bong"
                    }
                  ]
                }
              ],
              "w": 12
            },
            {
              "el": "f-dialog",
              "attr": {
                "v-model": "IsShowDialogConfirm",
                "title": "Xác nhận trước khi lưu",
                ":width": 600,
                ":controls": [
                  {
                    "el": "v-list-item",
                    "attr": {
                      "v-for": "hocSinh in vueData.renderDSHocSinhChange()",
                      ":title": "hocSinh.HoTen + ' - Lớp ' + hocSinh.TenLop"
                    }
                  }
                ],
                ":button": [
                  {
                    "label": "Đóng",
                    "action": {
                      "IsShowDialogConfirm": false
                    }
                  },
                  {
                    "label": "Xác nhận",
                    ":loading": "isLoadingSave",
                    "action": {
                      "EXE": "confirmSaveHocBong()"
                    }
                  }
                ]
              },
              "w": 12
            },
            {
              "el": "f-dialog",
              "attr": {
                "v-model": "IsShowDialogAdd",
                "title": "Thêm học sinh vào danh sách học bổng",
                ":width": 600,
                ":controls": [
                  {
                    "el": "v-autocomplete",
                    "attr": {
                      "v-model": "AddHocSinhSelected",
                      ":items": "DSAllHocSinh",
                      ":item-title": "item => item.HoTen + ' - ' + item.TenLop + ' (MSHS ' + item.HocSinhID + ')'",
                      ":return-object": true,
                      "label": "Tìm học sinh (họ tên / lớp / MSHS)",
                      "clearable": true,
                      "hide-details": "auto"
                    }
                  },
                  {
                    "el": "v-text-field",
                    "attr": {
                      "v-model": "AddMucHocBong",
                      "label": "Mức học bổng",
                      "class": "mt-4",
                      "hide-details": "auto"
                    }
                  }
                ],
                ":button": [
                  {
                    "label": "Đóng",
                    "action": {
                      "IsShowDialogAdd": false
                    }
                  },
                  {
                    "label": "Thêm",
                    ":loading": "isLoadingAdd",
                    "action": {
                      "EXE": "submitAddHocSinh()"
                    }
                  }
                ]
              },
              "w": 12
            },
            {
              "el": "f-dialog",
              "attr": {
                "v-model": "IsShowDialogDel",
                "title": "Xóa học sinh khỏi danh sách học bổng",
                ":width": 600,
                ":controls": [
                  {
                    "el": "v-autocomplete",
                    "attr": {
                      "v-model": "DelHocSinhSelected",
                      ":items": "DSHocBong",
                      ":item-title": "item => item.HoTen + ' - ' + item.TenLop + ' (MSHS ' + item.HocSinhID + ')'",
                      ":return-object": true,
                      "multiple": true,
                      "chips": true,
                      "label": "Chọn học sinh cần xóa",
                      "hide-details": "auto"
                    }
                  }
                ],
                ":button": [
                  {
                    "label": "Đóng",
                    "action": {
                      "IsShowDialogDel": false
                    }
                  },
                  {
                    "label": "Xóa",
                    "color": "warning",
                    ":loading": "isLoadingDel",
                    "action": {
                      "EXE": "submitDelHocSinh()"
                    }
                  }
                ]
              },
              "w": 12
            }
          ]
        }
      ]
    }
  ],
  "set": {}
}